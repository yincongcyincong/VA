{
  "name": "va-avatar",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "test:desktop": "node --test test/desktop-smoke.mjs",
    "build:win": "node scripts/build.js win32",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include-all \"--test-coverage-include={bin,desktop,lib,integrations}/**/*.{js,mjs,cjs}\" \"test/*.test.js\"",
    "build:mac": "node scripts/build.js darwin",
    "build:dmg": "node scripts/build.js darwin --dmg"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@pixiv/three-vrm": "2.0.10",
    "cross-spawn": "7.0.6",
    "three": "0.160.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electron/asar": "4.3.2",
    "@electron/packager": "20.3.0",
    "electron": "45.4.1"
  },
  "description": "桌面 3D 虚拟角色",
  "main": "desktop/main.js",
  "bin": {
    "va": "bin/va.js"
  }
}
